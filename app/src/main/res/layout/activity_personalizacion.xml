<?xml version="1.0" encoding="utf-8"?>
<!--
    ARCHIVO: activity_personalizacion.xml
    FUNCIÓN: Permite personalizar la experiencia de Bloomora.
    CONTIENE: Nombre del usuario y duración de la sesión de enfoque.
    ACTIVITY: PersonalizacionActivity.java
-->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_jardin"
    android:fillViewport="true">

    <!-- CONTENEDOR GENERAL SIN PADDING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CONTENIDO CON MÁRGENES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla">

            <!-- Logo -->
            <ImageView
                android:layout_width="@dimen/tamano_logo"
                android:layout_height="@dimen/tamano_logo"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margen_superior_logo"
                android:contentDescription="@string/descripcion_logo"
                android:src="@drawable/logo_bloomora" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espaciado_medio"
                android:text="@string/titulo_personalizacion"
                android:textColor="@color/verde_oscuro"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_pequeno"
                android:gravity="center"
                android:text="@string/subtitulo_personalizacion"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_normal" />

            <!-- Datos de personalización -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_grande"
                android:background="@drawable/bg_tarjeta"
                android:orientation="vertical"
                android:padding="@dimen/relleno_tarjeta">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/como_llamarte"
                    android:textColor="@color/texto_principal"
                    android:textSize="@dimen/texto_subtitulo"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNombreUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_medio"
                    android:backgroundTint="@color/verde_principal"
                    android:hint="@string/pista_nombre"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_grande"
                    android:text="@string/tiempo_enfoque"
                    android:textColor="@color/texto_principal"
                    android:textSize="@dimen/texto_subtitulo"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spDuracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_medio"
                    android:entries="@array/duraciones_enfoque" />

            </LinearLayout>

            <!-- Guardar -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuardarPersonalizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_grande"
                android:background="@drawable/bg_boton_principal"
                android:text="@string/guardar_personalizacion"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Volver -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_pequeno"
                android:background="@drawable/bg_boton_secundario"
                android:text="@string/volver"
                android:textColor="@color/verde_oscuro"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- ESPACIO FLEXIBLE -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- PASTITO BLOOMORA -->
        <ImageView
            android:id="@+id/imgPastoFooter"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/pasto_footer" />

    </LinearLayout>

</ScrollView>