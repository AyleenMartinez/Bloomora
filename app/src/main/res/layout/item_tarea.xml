<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaciado_medio"
    android:background="@drawable/bg_tarjeta"
    android:orientation="vertical"
    android:padding="@dimen/relleno_tarjeta">

    <TextView
        android:id="@+id/tvItemNombreTarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_principal"
        android:textSize="@dimen/texto_subtitulo"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvItemAsignatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_pequeno"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_normal" />

    <TextView
        android:id="@+id/tvItemEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_pequeno"
        android:textColor="@color/verde_principal"
        android:textSize="@dimen/texto_normal"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnUsarTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_medio"
        android:background="@drawable/bg_boton_secundario"
        android:text="@string/usar_para_enfocarme"
        android:textColor="@color/verde_oscuro"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>