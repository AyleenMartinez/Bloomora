<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_jardin"
    android:fillViewport="true">

    <!-- CONTENEDOR GENERAL SIN PADDING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CONTENIDO DE LA PANTALLA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla">

            <!-- Logo -->
            <ImageView
                android:layout_width="@dimen/tamano_logo"
                android:layout_height="@dimen/tamano_logo"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margen_superior_logo"
                android:contentDescription="@string/descripcion_logo"
                android:src="@drawable/logo_bloomora" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espaciado_medio"
                android:text="@string/titulo_detalle_tarea"
                android:textColor="@color/verde_oscuro"
                android:textSize="@dimen/texto_encabezado"
                android:textStyle="bold" />

            <!-- Tarjeta de detalle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_grande"
                android:background="@drawable/bg_tarjeta"
                android:orientation="vertical"
                android:padding="@dimen/relleno_tarjeta">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detalle_asignatura"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvDetalleAsignatura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_medio"
                    android:text="@string/detalle_tarea"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvDetalleTarea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_medio"
                    android:text="@string/detalle_estado"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvDetalleEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Volver -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_grande"
                android:background="@drawable/bg_boton_secundario"
                android:text="@string/volver"
                android:textColor="@color/verde_oscuro"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- ESPACIO FLEXIBLE -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- PASTITO BLOOMORA -->
        <ImageView
            android:id="@+id/imgPastoFooter"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/pasto_footer" />

    </LinearLayout>

</ScrollView>