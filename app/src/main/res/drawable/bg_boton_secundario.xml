<?xml version="1.0" encoding="utf-8"?>
<!--
    ARCHIVO: bg_boton_secundario.xml
    FUNCIÓN: Fondo para acciones secundarias y herramientas de estudio.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Botón presionado -->
    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="@color/verde_claro" />

            <corners android:radius="@dimen/radio_borde_pequeno" />

            <stroke
                android:width="1dp"
                android:color="@color/verde_principal" />

            <padding
                android:left="@dimen/espaciado_medio"
                android:top="@dimen/espaciado_pequeno"
                android:right="@dimen/espaciado_medio"
                android:bottom="@dimen/espaciado_pequeno" />

        </shape>

    </item>

    <!-- Estado normal -->
    <item>

        <shape android:shape="rectangle">

            <solid android:color="@color/superficie_jardin" />

            <corners android:radius="@dimen/radio_borde_pequeno" />

            <stroke
                android:width="1dp"
                android:color="@color/verde_claro" />

            <padding
                android:left="@dimen/espaciado_medio"
                android:top="@dimen/espaciado_pequeno"
                android:right="@dimen/espaciado_medio"
                android:bottom="@dimen/espaciado_pequeno" />

        </shape>

    </item>

</selector>